<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="LelSploit"
      Manufacturer="LelSploit"
      Version="1.0.0"
      UpgradeCode="f366c8d9-0cc0-4c84-9e4b-bab8c80ef2f7"
      Scope="perMachine">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of LelSploit is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Program Files -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LelSploit">

        <Component Id="MainProgram">
          <File
              Id="LelSploitExe"
              Source="LelSploit.exe"
              KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="LelSploitProgramMenuFolder" Name="LelSploit">

        <Component Id="StartMenuShortcut">

          <Shortcut
              Id="LelSploitShortcut"
              Name="LelSploit"
              Description="LelSploit"
              Target="[#LelSploitExe]"
              WorkingDirectory="INSTALLFOLDER" />

          <RemoveFolder
              Id="RemoveLelSploitProgramMenuFolder"
              Directory="LelSploitProgramMenuFolder"
              On="uninstall" />

          <RegistryValue
              Root="HKCU"
              Key="Software\LelSploit"
              Name="Installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />

        </Component>

      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature">
      <ComponentRef Id="MainProgram" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>

</Wix>